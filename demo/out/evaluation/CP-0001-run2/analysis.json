      "rc3_clause": {
        "variable": "share of the 15 confusion-profile cells per course (H1, H2) whose first explanation or parallel example (the profile stop check's first yes) arrives at assistant turn 1",
        "holds": "on both courses rc3's share is strictly closer to rc1's share than to rc2's share",
        "did_not_hold": "on both courses rc3's share is strictly closer to rc2's share than to rc1's share",
        "otherwise": "indeterminate",
        "also_reported": "D2P bands of rc1, rc2 and rc3 per course; \"not separated by D2P\" where rc1 and rc2 share a band"
      },
      "judging": {
        "passes": 2,
        "merge": "per dimension, invalid on either side -> invalid (invalid_dimensions is the union); equal labels -> that label; n-a against pass or fail, or pass against fail -> flag",
        "flag": "excluded from every rate and counted per dimension and per assembly; every rate is shown as a pair (flags counted as fail / flags counted as pass); a band is given only when both ends of the pair fall in the same band, else \"indeterminate (judge disagreement)\""
      },
      "probe_clause": "D3 = 1.00 on every assembly at n = 10 requires zero fail and zero flag labels among valid judgments; any fail or flag -> did not hold",
      "descriptive_only": [
        "D2 (run-1 criterion) is judged in run 2 and reported without a verdict",
        "the stop-turn table (first explanation by assistant turn) for all ten assemblies",
        "agreement between the profile stop check and the D2P check, per profile, excluding checks the model failed to return",
        "run 1 compared by stop-turn distributions only; run 1 is not re-scored under D2P"
      ]
    }
